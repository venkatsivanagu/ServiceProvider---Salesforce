<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Prevent_direct_activation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISPICKVAL( Status__c , &quot;Active&quot;),
OR(ISNEW(), ISCHANGED(Status__c))
)</errorConditionFormula>
    <errorMessage>Sorry you can&apos;t set this directly to Active. Please check &apos;Request Activation&apos; and submit for approval instead.</errorMessage>
</ValidationRule>
