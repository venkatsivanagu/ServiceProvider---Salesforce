<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Amount_is_not_in_negative</fullName>
    <active>true</active>
    <description>To check the entered amount is not in negative</description>
    <errorConditionFormula>Amount__c &lt;= 0</errorConditionFormula>
    <errorDisplayField>Amount__c</errorDisplayField>
    <errorMessage>Please enter a valid amount</errorMessage>
</ValidationRule>
